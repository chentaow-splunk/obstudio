FROM node:22-bookworm-slim AS ui-dependencies
WORKDIR /client
COPY observer/client/package.json observer/client/package-lock.json ./
RUN npm ci --ignore-scripts

FROM golang:1.26-bookworm AS builder
WORKDIR /src/observer
COPY observer/go.mod observer/go.sum ./
RUN go mod download
COPY observer/ ./
COPY --from=ui-dependencies /client/node_modules ./client/node_modules
COPY skills/ /src/skills/
COPY docs/examples.md /src/docs/examples.md
RUN go run ./cmd/stage-skills && go run ./cmd/build-client
RUN CGO_ENABLED=0 go build -ldflags '-X main.version=0.1.4-declarative-local' -o /out/obstudio ./cmd/obstudio

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /out/obstudio /usr/local/bin/obstudio
WORKDIR /workspace
CMD ["obstudio", "--host=0.0.0.0"]
